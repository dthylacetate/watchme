{
  "name": "watchme",
  "private": true,
  "type": "module",
  "workspaces": [
    "refactor/apps/*",
    "refactor/packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "tsx watch refactor/apps/server/src/index.ts",
    "dev:web": "next dev refactor/apps/web",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsup refactor/apps/server/src/index.ts --format esm --target node22 --out-dir refactor/apps/server/dist --clean && node refactor/scripts/fix-node-sqlite-build.mjs",
    "build:web": "next build refactor/apps/web",
    "package:server": "npm run build && node refactor/scripts/prepare-server-release.mjs",
    "check:release": "node refactor/scripts/check-release-health.mjs",
    "soak:server": "node refactor/scripts/soak-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.12.23",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
